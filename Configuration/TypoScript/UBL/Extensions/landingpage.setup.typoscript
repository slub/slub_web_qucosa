# Suppress the generic "<h1>{page.title}</h1>" from Singlecolumn.html (#2040)
# on the landing page only — its own template already shows document
# title/subtitle prominently. Page uid must match settings.landingPage below.
[globalVar = TSFE:id = 40]
    page.10.variables.hideTitle = TEXT
    page.10.variables.hideTitle.value = 1
[global]

plugin.tx_dpf_landingpage {
    view {
        templateRootPaths {
            0 = EXT:dpf/Resources/Private/Templates/
            10 = EXT:slub_web_qucosa/Resources/Private/Templates/
        }
        partialRootPaths {
            0 = EXT:dpf/Resources/Private/Partials/
            10 = EXT:slub_web_qucosa/Resources/Private/Partials/
        }
        layoutRootPaths {
            0 = EXT:dpf/Resources/Private/Layouts/
            10 = EXT:slub_web_qucosa/Resources/Private/Layouts/
        }
    }

    settings {
        # TYPO3 page uid for the GetFileController (apiPid=46 on test, set per environment)
        apiPid = 46
        # Configuration PID for tx_dpf_metadata records
        pages = 1
        # Landing page uid — update to new page uid after cutover from PI plugins
        landingPage = 40
        # METS fileGrp for downloads (DOWNLOAD on UBL)
        fileGrpDownload = DOWNLOAD
        # Separator for multi-value metadata fields
        separator = ,

        # Document type labels — mirrors plugin.tx_dpf_metadata.labels.type
        labels {
            type {
                article = Zeitschriftenartikel
                bachelor_thesis = Abschlussarbeit (Bachelor)
                book = Monographie
                monograph = Monographie
                report = Forschungsbericht / Report
                contained_work = Beitrag in Sammelband
                in_book = Beitrag in Sammelband
                diploma_thesis = Abschlussarbeit (Diplom)
                doctoral_thesis = Dissertation
                research_paper = Working Paper
                habilitation_thesis = Habilitationsschrift
                musical_notation = Noten (Musik)
                composition = Noten (Musik)
                proceeding = Konferenzband
                in_proceeding = Beitrag in Konferenzband
                magister_thesis = Abschlussarbeit (Magister)
                master_thesis = Abschlussarbeit (Master)
                multivolume_work = Mehrbändiges Werk
                preprint = Preprint
                series = Schriftenreihe
                text = Anderer Publikationstyp
                study = Anderer Publikationstyp
                paper = Studienarbeit
                lecture = Wissenschaftliche Vortragsfolien
                journal = Zeitschrift/Zeitung
                periodical = Zeitschrift
                issue = Zeitschriftenheft
                in_encyclopedia = Beitrag in Nachschlagewerk
                contributionToPeriodical = Beitrag/Interview in nicht-wiss. Medien
                editedCollection = Sammelband
                partOfADynamicWebResource = Beitrag in wissenschaftlichen Blogs
                researchData = Forschungsdaten
                software = Software
                encyclopedia = Nachschlagewerk
                conferencePoster = Poster
                sourceEdition = Quellenedition
                specialIssue = Sonderheft einer Zeitschrift
            }

            # Peer Review status labels (#2047: German spellouts instead of raw yes/no/unknown)
            # — mirrors plugin.tx_dpf_metadata.labels.peer_review
            peer_review {
                yes = ja
                no = nein
                unknown = unbekannt
                true = ja
                false = nein
            }

            # Dokumenttyp (mods:genre) sub-classification labels (#2050)
            document_type {
                researchArticle = Wissenschaftlicher Artikel
                editorial = Editorial / Vorwort / Nachwort
                reviewArticle = Review
                recension = Rezension
                courseMaterial = Praxisbeitrag
                letterToTheEditor = Letter to the Editor / Korrespondenz
                meetingAbstract = Meeting Abstract
                corrigendum = Erratum
                commentary = Gesetzeskommentar
                annotation = Entscheidungsanmerkung
            }
        }
    }
}
